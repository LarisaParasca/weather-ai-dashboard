# Copy this file to .env and fill in the key. These values are read only on the
# server (in /api/image) and are never sent to the browser. Never prefix them with NEXT_PUBLIC_.

# Required for image generation. Your OpenAI API key (https://platform.openai.com/api-keys).
# Without it the weather dashboard still works; only "Generate image" shows an error.
OPENAI_API_KEY=

# Optional. Which OpenAI image model to use. Default: gpt-image-2.
# Do not use gpt-image-1: OpenAI shut it down on 2026-10-23, so requests with it fail.
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional. How long to wait for the image, in milliseconds, before giving up
# and showing a timeout message. Default: 60000 (60 seconds).
IMAGE_TIMEOUT_MS=60000
